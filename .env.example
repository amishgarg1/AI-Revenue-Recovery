# Copy to .env and fill in. Every value here is OPTIONAL.
#
# With an empty .env the demo still runs end to end: message bodies come from
# the deterministic fallback templates and payment links are simulated and
# flagged as such. A judge should never need our credentials to reproduce our
# numbers.

# ---------------------------------------------------------------- Razorpay
# Dashboard -> Test Mode -> Settings -> API Keys -> Generate Test Key.
# TEST MODE ONLY. A key starting with rzp_live_ must never go in this file.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RZP_KEY_SECRET=

# ---------------------------------------------------------------- LLM
# Either one works; Groq is the default. Without a key the validator path is
# still exercised through the fallback, and `llm_used` reads false everywhere,
# which is the honest result rather than a hidden one.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Leave unset and the client tries a short candidate list and keeps
# the first model that answers — providers retire model ids often, and a
# hardcoded dead one makes the whole LLM path fall silently back to templates.
# LLM_MODEL=groq/qwen/qwen3.8-27b

# ---------------------------------------------------------------- Voice
# Sarvam AI, used to render the Hinglish voice scripts as audio for the demo.
SARVAM_API_KEY=

# ---------------------------------------------------------------- Webhooks
# The secret Razorpay signs webhooks with. Dashboard -> Settings -> Webhooks.
#
# Only used by POST /api/live/payment-failed. With it set, an unsigned or
# altered body is refused with a 401; without it the decision still runs but
# the response reports `signature_verified: false` rather than implying a
# check that did not happen. Any string works for a local demo - it just has
# to match on both sides.
RZP_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Policy
# Where the gates read their numbers from. Defaults to config/policy.yaml, and
# a missing file falls back to the values the committed evaluation was
# produced with. Point this elsewhere to run a different merchant's rules.
# RECOVEROS_POLICY=config/policy.yaml

# ---------------------------------------------------------------- Testing
# Forces the deterministic path everywhere: no LLM calls, no live payment
# links, whatever else is configured. The test suite sets this itself; set it
# here only if you want a fully offline run with keys still in the file.
# RECOVEROS_OFFLINE=1

# ---------------------------------------------------------------- Frontend
# Set in Vercel to the deployed backend URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
